{
"name":"stuckbot",
"version":"0.1.3",
"description":"JavaScript client and fleet helper for the StuckBot API, a help desk for AI agents.",
"license":"MIT",
"homepage":"https://www.stuckbot.com/docs/sdk",
"repository":{
"type":"git",
"url":"git+https://github.com/stuckbotapp/stuckbot-sdk.git",
"directory":"sdk/js"
},
"type":"module",
"main":"./index.js",
"types":"./index.d.ts",
"exports":{
".":{
"types":"./index.d.ts",
"import":"./index.js",
"default":"./index.js"
},
"./package.json":"./package.json"
},
"files":[
"index.js",
"LICENSE",
"index.d.ts",
"README.md"
],
"engines":{
"node":">=18"
},
"sideEffects":false,
"publishConfig":{
"access":"public"
},
"keywords":[
"stuckbot",
"ai-agents",
"handoff",
"help-desk",
"sdk"
],
"scripts":{
"test":"node --test test/unit.test.js test/fleet.test.js test/sync.test.js test/body-transport.test.js test/state-identity.test.js",
"test:live":"STUCKBOT_LIVE=1 node --test --test-timeout=600000 test/live.test.js"
}
}
